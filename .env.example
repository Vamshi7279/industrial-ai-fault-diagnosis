# Industrial AI Fault Diagnosis Platform Environment Variables

# Database Configuration
DATABASE_URL=sqlite:///./industrial_plant.db
# POSTGRES_URL=postgresql://admin:secret@localhost:5432/industrial_db

# Security & Authentication
JWT_SECRET_KEY=super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Redis Cache & Queue
REDIS_URL=redis://localhost:6379/0

# Telemetry WebSocket Host
TELEMETRY_WS_HOST=127.0.0.1
TELEMETRY_WS_PORT=8000

# Telegram Notification Gateway
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# WhatsApp Cloud API Gateway
WHATSAPP_API_TOKEN=your_whatsapp_cloud_api_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_RECIPIENT_PHONE=your_recipient_phone_here

# SMTP Email Gateway
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=alerts@industrial-ai-platform.com
SMTP_PASSWORD=your_app_specific_password_here
SMTP_SENDER_EMAIL=alerts@industrial-ai-platform.com
SMTP_RECIPIENT_EMAIL=manager@industrial-ai-platform.com

# System Observability & Logging
LOG_LEVEL=INFO
DEBUG=False
